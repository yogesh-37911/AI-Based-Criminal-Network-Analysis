ENV=development
DATABASE_URL=postgresql+psycopg2://forge:forge@postgres:5432/forge_ai
SECRET_KEY=change-this-to-a-random-32-byte-value-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:3000"]
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=200
