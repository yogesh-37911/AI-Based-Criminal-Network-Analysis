NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-ai/deepseek-v4.1-flash
KIMI_API_KEY=
KIMI_MODEL=moonshotai/kimi-k2.6
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=all-MiniLM-L6-v2
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
